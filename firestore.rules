rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users can access their profiles and other users' public profile/keys
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || resource == null);

      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Authenticated users can participate in conversations
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Authenticated users can create and manage WebRTC call signaling sessions
    match /calls/{callId} {
      allow read, write: if request.auth != null;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
